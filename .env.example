# Meta Model API key from https://dev.meta.ai (Billing must show the hackathon credit)
MODEL_API_KEY=

# Private Mode: Muse Spark Open (open weights) on partner inference, any OpenAI compatible endpoint.
# Baseten (default):  OPEN_WEIGHTS_BASE_URL=https://inference.baseten.co/v1  OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open-1026
# Fireworks or Modal: set the base URL and model id they give you, and OPEN_WEIGHTS_PROVIDER to their name.
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_MODEL=
OPEN_WEIGHTS_PROVIDER=

# Optional spend cap in USD for the Meta credit (default 60)
MOMENTALK_COST_CAP_USD=60
